/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": "./src",
    "paths": {
      "@shared/angular": ["app/shared/angular/index.ts"],
      "@primeng": ["app/shared/primeng/index.ts"],
      "@app": ["app/index.ts"],
      "@app/*": ["app/*"],
      "@core": ["app/core/index.ts"],
      "@core/*": ["app/core/*"],
      "@shared": ["app/shared/index.ts"],
      "@shared/*": ["app/shared/*"],
      "@ui": ["app/shared/ui/index.ts"],
      "@form-controls": ["app/shared/ui/form-controls/index.ts"],
      "@components": ["app/shared/ui/components/index.ts"],
      "@dialogs": ["app/shared/ui/dialogs/index.ts"],
      "@layout": ["app/shared/ui/layout/index.ts"],
      "@services": ["app/core/services/index.ts"],
      "@guards": ["app/core/guards/index.ts"],
      "@interceptors": ["app/core/interceptors/index.ts"],
      "@validators": ["app/shared/validators/index.ts"],
      "@pipes": ["app/shared/pipes/index.ts"],
      "@directives": ["app/shared/directives/index.ts"],
      "@helpers": ["app/shared/helpers/index.ts"],
      "@utils": ["app/shared/utils/index.ts"],
      "@constants": ["app/core/constants/index.ts"],
      "@enums": ["app/core/enums/index.ts"],
      "@models": ["app/core/models/index.ts"],
      "@core/providers": ["app/core/providers/index.ts"],
      "@state": ["app/core/state/index.ts"],
      "@auth": ["app/core/auth/index.ts"],
      "@configuration": ["app/core/configuration/index.ts"],
      "@tokens": ["app/core/tokens/index.ts"],
      "@features": ["app/features/index.ts"],
      "@pages": ["app/pages/index.ts"],
      "@environment": ["environments/environment"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
