{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MyCompanyDb_Prod;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "THIS_IS_ENTERPRISE_PROD_SECRET_KEY_123456789",
    "Issuer": "MyCompany.API.Prod",
    "Audience": "MyCompany.Client.Prod",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://yourdomain.com"
    ]
  },
  "PasswordHasherOptions": {
    "IterationCount": 100000
  }
}
