{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=MyCompanyDb_Test;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "THIS_IS_ENTERPRISE_TEST_SECRET_KEY_123456789",
    "Issuer": "MyCompany.API.Test",
    "Audience": "MyCompany.Client.Test",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://test.yourdomain.com"
    ]
  },
  "PasswordHasherOptions": {
    "IterationCount": 100000
  }
}
